# Copy to .env and adjust for your home deployment.
POSTGRES_DB=mealplanner
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=mealplanner
POSTGRES_PORT=5433

# Consumed by the app (see src/main/resources/application.yaml)
DATABASE_URL=jdbc:postgresql://localhost:5433/mealplanner
DATABASE_USER=mealplanner
DATABASE_PASSWORD=mealplanner
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Set when the planner is reached through a proxy or a host name, so the
# recipe-import bookmarklet points somewhere everyone can use.
# APP_BASE_URL=http://nas.local:8080
